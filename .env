# ==============================================================================
# Clock-Clock Application Environment Configuration
# Version: 2026.09.21.17.25.00
# Description: Configuration for Clock-Clock display, pattern toggles, and e-ink reversal
# ==============================================================================

# Reverse colors (true for black hands/strokes on white background for e-ink displays, false for classic white-on-black)
# Default: false
VITE_REVERSE_COLORS=true

# Active color palette index (0 to 4)
# Default: 0
# Palette 0: Classic Monochrome (Deep Black & Pure White)
# Palette 1: Adobe Kuler - Flat Design Slate
# Palette 2: Adobe Kuler - Retro Metro Warm
# Palette 3: Adobe Kuler - Techno Slate
# Palette 4: Adobe Kuler - Paper & Charcoal Minimalist
VITE_PALETTE_INDEX=0

# Global seed for deterministic random transitions
# Default: 42
VITE_RANDOM_SEED=42

# ==============================================================================
# Pattern Enable / Disable Flags
# Set to 'true' to include in animation cycles, or 'false' to disable/exclude
# ==============================================================================
VITE_PATTERN_CURRENT_TIME=true
VITE_PATTERN_SNAKE=true
VITE_PATTERN_SQUARES=true
VITE_PATTERN_WAVES=true
VITE_PATTERN_X_CROSS=true
VITE_PATTERN_COLUMNS=true
VITE_PATTERN_CHAOS_1=true
VITE_PATTERN_VERTICAL_WEAVE=true
VITE_PATTERN_DIAGONAL_WEAVE=true
VITE_PATTERN_CHAOS_2=true
VITE_PATTERN_ALL_VERTICAL=true
VITE_PATTERN_ALL_HORIZONTAL=true
VITE_PATTERN_SOMERSAULTS=true
VITE_PATTERN_SMILIES=true
